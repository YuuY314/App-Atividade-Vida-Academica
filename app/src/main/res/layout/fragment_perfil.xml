<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="20dp"
    tools:context=".PerfilFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:id="@+id/perfil_fragment_titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MEU PERFIL"
        android:textStyle="bold"
        android:textSize="30dp"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <androidx.cardview.widget.CardView
        android:id="@+id/disciplinas_fragment_card_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/perfil_fragment_titulo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">


            <TextView
                android:text="Rafael Yu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:textStyle="bold"
                />

            <TextView
                android:text="Técnico em Desenvolvimento de Sistemas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                />

            <TextView
                android:text="3° Semestre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                />

            <TextView
                android:text="SENAI Armando de Arruda Pereira"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16dp"
                />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>